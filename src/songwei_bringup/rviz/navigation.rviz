Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane: XY
    Plane Cell Count: 40
    Color: 100; 100; 100
    Alpha: 0.2
    Reference Frame: map
  - Class: rviz_default_plugins/Map
    Name: Saved Map
    Enabled: true
    Alpha: 0.9
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Update Topic:
      Value: /map_updates
      Depth: 10
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
    Use Timestamp: false
  - Class: rviz_default_plugins/LaserScan
    Name: Laser Scan
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
    Selectable: true
    Style: Points
    Size (Pixels): 3
    Size (m): 0.02
    Color Transformer: FlatColor
    Color: 255; 90; 65
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: MID360 Cloud
    Enabled: false
    Topic:
      Value: /songwei/cloud_deskewed
      Depth: 5
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
    Style: Points
    Size (Pixels): 2
    Size (m): 0.01
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Axis: Z
    Alpha: 0.5
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/RobotModel
    Name: Ranger Mini V3
    Enabled: true
    Alpha: 0.8
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Visual Enabled: true
    Collision Enabled: false
    TF Prefix: ''
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Marker Scale: 0.5
    Frame Timeout: 15
  - Class: rviz_default_plugins/Path
    Name: Planned Path
    Enabled: true
    Color: 0; 220; 80
    Line Style: Lines
    Line Width: 0.04
    Topic:
      Value: /plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/Polygon
    Name: Footprint
    Enabled: true
    Color: 255; 200; 0
    Topic:
      Value: /local_costmap/published_footprint
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 40
      Angle: 0
      X: 0
      Y: 0
  Enabled: true
Window Geometry:
  Width: 1200
  Height: 850
  X: 50
  Y: 50
  Displays:
    collapsed: false
  Views:
    collapsed: true
